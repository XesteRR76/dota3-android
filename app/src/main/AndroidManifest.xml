<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_dota_icon"
        android:roundIcon="@drawable/ic_dota_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dota3">

        <activity
            android:name=".ui.MainMenuActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HeroDraftActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.GameActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:keepScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.EncyclopediaActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>

</manifest>
